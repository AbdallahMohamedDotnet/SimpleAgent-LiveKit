# LiveKit server connection
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Name the agent worker registers under for explicit dispatch
LIVEKIT_AGENT_NAME=interviewer

# ElevenLabs (STT: Scribe realtime, TTS)
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=

# OpenRouter (OpenAI-compatible LLM endpoint)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# SQLite database file path (relative to packages/db)
DATABASE_URL=./data/interviews.db

# Next.js app — public LiveKit URL exposed to the browser
NEXT_PUBLIC_LIVEKIT_URL=

# --- Latency tuning (all optional; the defaults shown are what the agent uses) ---
# End-of-turn detection. `v1-mini` runs LiveKit's turn detector in-process — no network hop per
# pause. Use `v1` (cloud model, more accurate) only on LiveKit Cloud. `vad`/`stt` skip semantic
# detection entirely: fastest, but they cut people off mid-thought.
TURN_DETECTOR=v1-mini
# Silence before the agent takes the turn, and the hard ceiling on how long it waits.
# Lower = snappier but more likely to interrupt; SDK defaults are 500 / 3000.
ENDPOINTING_MIN_DELAY_MS=300
ENDPOINTING_MAX_DELAY_MS=2000
# Synthesise the reply before the user's turn is confirmed. Removes the TTS round trip from the
# critical path; costs some discarded ElevenLabs characters on false endpoints.
PREEMPTIVE_TTS=true
# Caps a single spoken reply. A runaway answer is experienced as the agent being slow.
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.4
# The one-shot call that builds topic 3's questions from topic 2's answers. This is the longest
# pause in the interview — point it at a small fast model to shrink it. Defaults to OPENROUTER_MODEL.
PROBE_PLANNER_MODEL=
# Total budget for that call before falling back to the static question plan.
PROBE_PLANNER_TIMEOUT_MS=6000
