# Local LiveKit server; do not use a cloud URL for this application.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Required provider configuration. Keep real values in an untracked .env file.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
ELEVEN_API_KEY=
ELEVEN_STT_MODEL=scribe_v2_realtime
ELEVEN_TTS_MODEL=eleven_turbo_v2_5
HR_VOICE_ID=
TECH_VOICE_ID=
INTERVIEW_LANGUAGE=en
HR_TARGET_SECONDS=300
TECH_TARGET_SECONDS=300
IDLE_CHECKIN_SECONDS=5
THINKING_HOLD_SECONDS=20
